---
import Base from '~/layouts/Base.astro'
import SocialLinks from '~/components/SocialLinks.astro'
import { site } from '~/data/site'

// TODO(#33): full content rewrite pending (content interview). Facts here are
// current (California, Senior Software Engineer); prose is intentionally light.
---

<Base title="About" description="A little about Marin Minnerly.">
	<section class="wrap section about">
		<h1>About</h1>
		<p>
			Hey — I'm {site.name}. I'm a senior software engineer living in {site.location},
			where I've been for about five years. I work full-time at
			<a href="https://corp.roblox.com">Roblox</a>.
		</p>
		<p>
			I've been programming since I was a teenager, most of it in Lua and Luau,
			with a solid footing in JavaScript and Python too.
		</p>
		<p>
			For the software side of things, my <a href="https://github.com/vocksel">GitHub</a>
			is the best place to look. For everything else, there's the
			<a href="/projects">projects</a> page.
		</p>
		<div class="about__links">
			<SocialLinks />
		</div>
	</section>
</Base>

<style>
	.about {
		max-width: 42rem;
		padding-block: 3rem;
	}
	.about h1 {
		font-size: clamp(2rem, 5vw, 2.8rem);
		margin: 0 0 1.2rem;
	}
	.about p {
		max-width: 60ch;
	}
	.about__links {
		margin-top: 1.8rem;
	}
</style>
