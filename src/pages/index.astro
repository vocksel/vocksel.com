---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '~/layouts/Base.astro'
import SocialLinks from '~/components/SocialLinks.astro'
import ProjectCard from '~/components/ProjectCard.astro'
import { site } from '~/data/site'
import { experience, education } from '~/data/experience'
import profile from '~/assets/me/profile.jpg'

const projects = (await getCollection('projects'))
	.filter((p) => p.data.featured)
	.sort((a, b) => b.data.order - a.data.order || b.data.year - a.data.year)
	.slice(0, 6)
---

<Base>
	<section class="wrap hero">
		<div class="hero__text">
			<h1>
				I'm <span class="hl">{site.name}</span> — a senior software engineer.
			</h1>
			<p class="lede">{site.blurb} Based in {site.location}.</p>
			<SocialLinks />
		</div>
		<div class="avatar">
			<Image src={profile} alt={`Photo of ${site.name}`} width={240} loading="eager" />
		</div>
	</section>

	<section class="wrap section">
		<div class="section-head">
			<h2>Experience</h2>
			<span class="rule"></span>
		</div>
		<div class="timeline">
			{
				experience.map((job) => (
					<article class="job">
						<div class="job__when">{job.period}</div>
						<div class="job__body">
							<h3>{job.role}</h3>
							<p class="job__co">{job.company}</p>
							{job.description && <p class="job__desc">{job.description}</p>}
							{job.highlights && (
								<ul class="job__highlights">
									{job.highlights.map((h) => (
										<li>{h}</li>
									))}
								</ul>
							)}
							{job.projects && (
								<ul class="job__projects" aria-label="Projects">
									{job.projects.map((p) => (
										<li>
											<a href={p.url}>{p.name}</a>
										</li>
									))}
								</ul>
							)}
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="wrap section">
		<div class="section-head">
			<h2>Education</h2>
			<span class="rule"></span>
		</div>
		<div class="timeline">
			{
				education.map((ed) => (
					<article class="job">
						<div class="job__when">{ed.period}</div>
						<div class="job__body">
							<h3>{ed.award}</h3>
							<p class="job__co">{ed.institution}</p>
							<p class="job__desc">
								{ed.location}
								{ed.details && <> · {ed.details}</>}
							</p>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="wrap section">
		<div class="section-head">
			<h2>Projects</h2>
			<span class="rule"></span>
			<a class="see-all" href="/projects">See all →</a>
		</div>
		<div class="grid">
			{
				projects.map((p) => (
					<ProjectCard
						slug={p.id}
						title={p.data.title}
						subtitle={p.data.subtitle}
						type={p.data.type}
						year={p.data.year}
						thumbnail={p.data.thumbnail}
					/>
				))
			}
		</div>
	</section>
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2.5rem;
		align-items: center;
		padding-block: 4.5rem 2.5rem;
	}
	.hero__text {
		max-width: 42rem;
	}
	.hero__text h1 {
		font-size: clamp(2rem, 5vw, 3.3rem);
		margin: 0 0 1.4rem;
	}
	.hl {
		color: var(--color-accent);
		white-space: nowrap;
	}
	.lede {
		color: var(--color-content-muted);
		font-size: 1.05rem;
		max-width: 46ch;
		margin: 0 0 1.8rem;
	}
	.avatar {
		width: 200px;
		max-width: 100%;
		border-radius: var(--radius-circle);
		border: var(--stroke-thick) solid var(--color-stroke-emphasis);
		padding: var(--padding-xsmall);
		background: var(--color-surface-100);
	}
	.avatar :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: var(--radius-circle);
	}

	/* Dusk keeps its highlighter underline and gradient photo ring. */
	:global([data-theme='dusk']) .hl {
		position: relative;
	}
	:global([data-theme='dusk']) .hl::after {
		content: '';
		position: absolute;
		left: -0.05em;
		right: -0.05em;
		bottom: 0.06em;
		height: 0.34em;
		background: color-mix(in srgb, var(--color-accent) 20%, transparent);
		z-index: -1;
		border-radius: 3px;
	}
	:global([data-theme='dusk']) .avatar {
		padding: 4px;
		border: 0;
		border-radius: 28px;
		background: linear-gradient(145deg, var(--color-accent), #8e3bd1);
	}
	:global([data-theme='dusk']) .avatar :global(img) {
		border-radius: 24px;
	}

	.see-all {
		font-size: 0.88rem;
		font-weight: 500;
		white-space: nowrap;
	}

	.timeline {
		display: grid;
	}
	.job {
		display: grid;
		grid-template-columns: 130px 1fr;
		gap: 1.4rem;
		padding: 1.1rem 0;
		border-top: 1px solid var(--color-stroke-default);
	}
	.job:first-child {
		border-top: 0;
	}
	.job__when {
		color: var(--color-content-muted);
		font-size: 0.82rem;
		font-variant-numeric: tabular-nums;
		padding-top: 0.15rem;
	}
	.job__body {
		min-width: 0;
	}
	.job__body h3 {
		margin: 0 0 0.2rem;
		font-size: 1.02rem;
	}
	.job__co {
		color: var(--color-content-link);
		font-weight: 500;
		margin: 0;
	}
	.job__desc {
		margin: 0.4rem 0 0;
		color: var(--color-content-muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}
	.job__highlights {
		margin: 0.5rem 0 0;
		padding-left: 1.1rem;
		color: var(--color-content-muted);
		font-size: 0.9rem;
		line-height: 1.6;
		display: grid;
		gap: 0.3rem;
	}
	.job__projects {
		list-style: none;
		margin: 0.7rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.job__projects a {
		display: inline-block;
		font-size: 0.78rem;
		font-weight: 500;
		padding: 0.2rem 0.6rem;
		border: 1px solid var(--color-stroke-default);
		border-radius: 999px;
		color: var(--color-content-emphasis);
		transition: border-color 0.16s, color 0.16s;
	}
	.job__projects a:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.1rem;
	}

	@media (max-width: 780px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1.6rem;
			padding-block: 3rem 1.5rem;
		}
		.avatar {
			width: 160px;
			order: -1;
		}
		.grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 520px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.job {
			grid-template-columns: 1fr;
			gap: 0.3rem;
		}
	}
</style>
