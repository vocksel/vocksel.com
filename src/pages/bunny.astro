---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Base from '~/layouts/Base.astro'

// Drop photos into src/assets/bunny/ and they show up here automatically —
// no code change needed. Newest filenames last; sorted by name.
const modules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/bunny/*.{jpg,jpeg,png,webp,avif}',
	{ eager: true }
)
const photos = Object.entries(modules)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([, m]) => m.default)
---

<Base title="Bunny" description="A gallery of my bunny.">
	<section class="wrap section">
		<header class="page-head">
			<h1>Bunny 🐰</h1>
			<p>The most important section of the whole site.</p>
		</header>

		{
			photos.length === 0 ? (
				<div class="empty">
					<p class="empty__title">No photos yet.</p>
					<p class="empty__sub">
						Drop images into <code>src/assets/bunny/</code> and they'll appear
						here automatically.
					</p>
				</div>
			) : (
				<div class="masonry">
					{photos.map((photo, i) => (
						<Image
							class="shot"
							src={photo}
							alt={`My bunny, photo ${i + 1}`}
							widths={[320, 640]}
							sizes="(max-width: 520px) 100vw, 320px"
							loading={i < 4 ? 'eager' : 'lazy'}
						/>
					))}
				</div>
			)
		}
	</section>
</Base>

<style>
	.page-head {
		padding-block: 3rem 2rem;
	}
	.page-head h1 {
		font-size: clamp(2rem, 5vw, 2.8rem);
		margin: 0 0 0.5rem;
	}
	.page-head p {
		color: var(--fg-dim);
		margin: 0;
	}
	.empty {
		border: 1px dashed var(--line);
		border-radius: var(--radius);
		padding: 3rem 1.5rem;
		text-align: center;
	}
	.empty__title {
		font-size: 1.3rem;
		font-weight: 600;
		margin: 0 0 0.4rem;
	}
	.empty__sub {
		color: var(--fg-dim);
		margin: 0;
	}
	.empty code {
		background: var(--bg-raised);
		padding: 0.1rem 0.4rem;
		border-radius: 5px;
		font-size: 0.85em;
	}
	/* Simple CSS masonry via columns. */
	.masonry {
		column-count: 3;
		column-gap: 1rem;
	}
	.masonry :global(.shot) {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		border: 1px solid var(--line);
		margin-bottom: 1rem;
		break-inside: avoid;
		display: block;
	}
	@media (max-width: 780px) {
		.masonry {
			column-count: 2;
		}
	}
	@media (max-width: 480px) {
		.masonry {
			column-count: 1;
		}
	}
</style>
