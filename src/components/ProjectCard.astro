---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
	slug: string
	title: string
	subtitle: string
	type: 'Game' | 'Code'
	year: number
	thumbnail: ImageMetadata
}

const { slug, title, subtitle, type, year, thumbnail } = Astro.props
const tagClass = type === 'Game' ? 'tag--game' : 'tag--code'
---

<a class="card" href={`/projects/${slug}`}>
	<span class="card__thumb">
		<Image
			src={thumbnail}
			alt=""
			widths={[320, 640]}
			sizes="(max-width: 520px) 100vw, 360px"
			loading="lazy"
		/>
	</span>
	<span class="card__body">
		<span class={`tag ${tagClass}`}>{type} · {year}</span>
		<span class="card__title">{title}</span>
		<span class="card__sub">{subtitle}</span>
	</span>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--color-surface-100);
		border: var(--stroke-standard) solid var(--color-stroke-muted);
		border-radius: var(--radius-card);
		overflow: hidden;
		color: var(--color-content-emphasis);
		transition:
			transform var(--time-200) var(--ease-standard-out),
			background var(--time-200) var(--ease-standard-out),
			border-color var(--time-200) var(--ease-standard-out),
			box-shadow var(--time-200) var(--ease-standard-out);
	}
	.card:hover {
		color: var(--color-content-emphasis);
		background: var(--color-surface-200);
		border-color: var(--color-stroke-emphasis);
	}
	:global([data-theme='dusk']) .card {
		background: linear-gradient(170deg, var(--color-surface-100), rgba(36, 24, 33, 0.4));
		border-color: var(--color-stroke-default);
	}
	:global([data-theme='dusk']) .card:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
		box-shadow: 0 18px 40px -22px color-mix(in srgb, var(--color-accent) 60%, transparent);
	}
	.card__thumb {
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--color-surface-100);
	}
	.card__thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}
	.card:hover .card__thumb :global(img) {
		transform: scale(1.04);
	}
	.card__body {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1rem 1.1rem 1.2rem;
	}
	.tag {
		align-self: flex-start;
		margin-bottom: 0.25rem;
	}
	.card__title {
		font-size: var(--text-title-large);
		font-weight: var(--font-weight-heading);
		letter-spacing: -0.01em;
	}
	.card__sub {
		color: var(--color-content-muted);
		font-size: var(--text-body-medium);
		line-height: 1.45;
	}
	@media (prefers-reduced-motion: reduce) {
		.card:hover .card__thumb :global(img) {
			transform: none;
		}
	}
</style>
