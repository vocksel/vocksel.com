---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
	slug: string
	title: string
	subtitle: string
	type: 'Game' | 'Code'
	year: number
	thumbnail: ImageMetadata
}

const { slug, title, subtitle, type, year, thumbnail } = Astro.props
const tagClass = type === 'Game' ? 'tag--game' : 'tag--code'
---

<a class="card" href={`/projects/${slug}`}>
	<span class="card__thumb">
		<Image
			src={thumbnail}
			alt=""
			widths={[320, 640]}
			sizes="(max-width: 520px) 100vw, 360px"
			loading="lazy"
		/>
	</span>
	<span class="card__body">
		<span class={`tag ${tagClass}`}>{type} · {year}</span>
		<span class="card__title">{title}</span>
		<span class="card__sub">{subtitle}</span>
	</span>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: linear-gradient(170deg, var(--bg-raised), rgba(36, 24, 33, 0.4));
		border: 1px solid var(--line);
		border-radius: var(--radius);
		overflow: hidden;
		color: var(--fg);
		transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
	}
	.card:hover {
		color: var(--fg);
		transform: translateY(-4px);
		border-color: rgba(255, 54, 133, 0.4);
		box-shadow: 0 18px 40px -22px rgba(255, 54, 133, 0.6);
	}
	.card__thumb {
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--bg-raised);
	}
	.card__thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}
	.card:hover .card__thumb :global(img) {
		transform: scale(1.04);
	}
	.card__body {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1rem 1.1rem 1.2rem;
	}
	.tag {
		align-self: flex-start;
		margin-bottom: 0.25rem;
	}
	.card__title {
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.card__sub {
		color: var(--fg-dim);
		font-size: 0.85rem;
		line-height: 1.5;
	}
	@media (prefers-reduced-motion: reduce) {
		.card:hover .card__thumb :global(img) {
			transform: none;
		}
	}
</style>
