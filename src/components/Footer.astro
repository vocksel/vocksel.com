---
import { site } from '~/data/site'
const year = new Date().getFullYear()
---

<footer class="footer">
	<div class="wrap footer__in">
		<p>Made with love in {site.location}.</p>
		<span class="pride-bar" aria-hidden="true"></span>
		<p class="footer__meta">© {year} {site.name}</p>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--line);
		margin-top: 2rem;
	}
	.footer__in {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		padding-block: 2.5rem 3.5rem;
		text-align: center;
		color: var(--fg-dim);
		font-size: 0.85rem;
	}
	.footer__in p {
		margin: 0;
	}
</style>
